# Payment-related variables only. Secrets must NEVER use the NEXT_PUBLIC_ prefix
# (that would ship them to the browser). All of these are server-side only.

# Bank transfer details shown to buyers (defaults are built in).
# BANK_NAME="Türkiye İş Bankası"
# BANK_ACCOUNT_NAME="Eyüboğlu Mezunlar Derneği"
# BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"

# Public site origin used to build payment return URLs (not a secret).
# NEXT_PUBLIC_SITE_URL=https://eymeder.com

# Gateway credentials: add once a provider is contracted. Names are up to the adapter, e.g.
# <PROVIDER>_API_KEY=
# <PROVIDER>_SECRET_KEY=
# <PROVIDER>_BASE_URL=
# <PROVIDER>_WEBHOOK_SECRET=
